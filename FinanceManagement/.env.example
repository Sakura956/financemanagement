# ===== 后端环境变量模板 =====
# 使用方法：
#   1. 本地开发：复制本文件为 .env，填入真实值（.env 已被 .gitignore 忽略）
#   2. 生产部署：在服务器上 export 同名环境变量，或把 .env 放到 jar 同目录，
#      再以 --spring.profiles.active=prod 启动
# 说明：application.yml 通过 spring.config.import 读取 .env；
#       application-dev.yml / application-prod.yml 用 ${VAR} 引用以下变量。

# MySQL 数据库密码
DB_PASSWORD=your_db_password

# Redis 密码（无密码请留空）
REDIS_PASSWORD=

# JWT 签名密钥（≥256 位随机字符串，生产环境务必更换）
JWT_SECRET=change-me-to-a-random-256-bit-secret

# AI 接口密钥（SiliconFlow / DeepSeek）；不使用 AI 可将 ai.enabled 设为 false
AI_API_KEY=your_siliconflow_api_key
